    "emg_gas_edit_msg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number the “Gas emergency” card dials for this property. Leave empty to reset to 0800-001122 (Romania)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul apelat de cardul „Urgență gaz\" pentru această proprietate. Gol = revine la 0800-001122 (România)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro qu’appelle la carte « Urgence gaz » pour cette propriété. Laissez vide pour revenir au 0800-001122 (Roumanie)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nummer dat de kaart ‘Gasnoodgeval’ voor deze woning belt. Laat leeg om terug te gaan naar 0800-001122 (Roemenië)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nummer, die die Karte „Gasnotfall“ für dieses Grundstück wählt. Leer lassen, um auf 0800-001122 (Rumänien) zurückzusetzen."
          }
        }
      }
    },
    "emg_gas_edit_ph": {
      "localizations": {
