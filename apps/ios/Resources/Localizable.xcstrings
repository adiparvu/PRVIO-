    "emg_place_photo_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo of the exact spot — the valve, the breaker panel — saves you searching in a panic."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O poză cu locul exact — robinetul, tabloul electric — te scutește de căutat în panică."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo de l’endroit exact — le robinet, le tableau électrique — vous évite de chercher dans la panique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een foto van de exacte plek — de kraan, de meterkast — scheelt zoeken in paniek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Foto der genauen Stelle — Hahn, Sicherungskasten — erspart dir die Suche in Panik."
          }
        }
      }
    },
