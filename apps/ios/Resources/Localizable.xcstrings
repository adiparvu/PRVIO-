    "watch_siri_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your wrist and speak — the watch updates instantly, and the action reaches your phone at the next sync."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică încheietura și vorbește — ceasul se actualizează instant, iar acțiunea ajunge pe telefon la următoarea sincronizare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levez le poignet et parlez — la montre se met à jour aussitôt, et l’action arrive sur votre iPhone à la prochaine synchronisation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Til je pols op en spreek — het horloge werkt direct bij, en de actie bereikt je iPhone bij de volgende synchronisatie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb dein Handgelenk und sprich — die Uhr aktualisiert sich sofort, und die Aktion erreicht dein iPhone bei der nächsten Synchronisierung."
          }
        }
      }
    },
