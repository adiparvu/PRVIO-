          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschwemmung"
          }
        }
      }
    },
    "emg_guide_flood_valve_link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main water valve — your saved place"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Robinetul general — locul salvat de tine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Robinet d’eau principal — votre lieu enregistré"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdkraan — je opgeslagen plek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauptwasserhahn — dein gespeicherter Ort"
          }
        }
      }
    },
    "emg_guide_gas_step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do NOT turn on lights, use switches, sockets, or any open flame."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NU aprinde lumina, nu folosi întrerupătoare, prize sau flacără deschisă."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’allumez PAS la lumière, ne touchez ni interrupteurs, ni prises, ni flamme nue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe GEEN licht aan, gebruik geen schakelaars, stopcontacten of open vuur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte KEIN Licht ein, benutze keine Schalter, Steckdosen oder offenes Feuer."
          }
        }
      }
    },
    "emg_guide_gas_step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the windows and doors wide."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide larg ferestrele și ușile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez grand les fenêtres et les portes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet ramen en deuren wijd open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Fenster und Türen weit."
          }
        }
      }
    },
    "emg_guide_gas_step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shut off the gas valve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide robinetul de gaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez le robinet de gaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai de gaskraan dicht."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh den Gashahn zu."
          }
        }
      }
    },
    "emg_guide_gas_step4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get everyone out of the house."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoate pe toată lumea din casă."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites sortir tout le monde de la maison."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal iedereen het huis uit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring alle aus dem Haus."
          }
        }
      }
    },
    "emg_guide_gas_step5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call the gas emergency line from outside, away from the house."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună la urgența de gaz de afară, de la distanță de casă."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez l’urgence gaz depuis l’extérieur, loin de la maison."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel het gasnoodnummer van buiten, uit de buurt van het huis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruf den Gasnotdienst von draußen an, mit Abstand zum Haus."
          }
        }
      }
    },
    "emg_guide_gas_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gas leak"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurgere de gaz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuite de gaz"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaslek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasleck"
          }
        }
      }
    },
    "emg_guide_power_step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the breaker panel — a tripped breaker flips back up."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică tabloul electric — o siguranță căzută se ridică la loc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le tableau électrique — remontez le disjoncteur qui a sauté."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk in de meterkast — zet een gesprongen groep weer omhoog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Sicherungskasten — eine ausgelöste Sicherung kippst du wieder hoch."
          }
        }
      }
    },
    "emg_guide_power_step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look outside: if the neighbours are dark too, it's a grid outage — report it to your provider."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Uită-te afară: dacă și vecinii sunt în beznă, e o avarie de rețea — anunță furnizorul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez dehors : si les voisins sont aussi dans le noir, c’est une panne de réseau — signalez-la à votre fournisseur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar buiten: zitten de buren ook in het donker, dan is het een netstoring — meld het bij je netbeheerder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau nach draußen: Sind die Nachbarn auch im Dunkeln, ist es ein Netzausfall — melde ihn deinem Anbieter."
          }
        }
      }
    },
    "emg_guide_power_step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplug sensitive appliances so the surge when power returns doesn't damage them."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoate din priză aparatele sensibile, ca revenirea curentului să nu le strice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débranchez les appareils sensibles pour que la surtension au retour du courant ne les abîme pas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal gevoelige apparaten uit het stopcontact, zodat de piek bij terugkeer van de stroom ze niet beschadigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh empfindliche Geräte aus der Steckdose, damit die Spannungsspitze bei Stromrückkehr sie nicht beschädigt."
          }
        }
      }
    },
    "emg_guide_power_step4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the fridge and freezer doors closed — they hold the cold for hours."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține ușile frigiderului și congelatorului închise — păstrează frigul câteva ore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le frigo et le congélateur fermés — ils restent froids pendant des heures."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd koelkast en vriezer dicht — die blijven urenlang koud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Kühlschrank und Gefrierschrank zu — sie halten die Kälte stundenlang."
          }
        }
      }
    },
    "emg_guide_power_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power outage"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pană de curent"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupure de courant"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroomstoring"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stromausfall"
          }
        }
      }
    },
