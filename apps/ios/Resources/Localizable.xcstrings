        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluări"
          }
        }
      }
    },
    "export_share": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share export"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajează exportul"
          }
        }
      }
    },
    "export_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours to take"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ale tale, oricând"
          }
        }
      }
    },
    "export_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Data"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale"
          }
        }
      }
    },
    "faq_account_id_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account has a permanent ID in the form PRVIO-XXXXXXXX, derived from your account itself. You find it in Profile — tap it to copy. You can also type it in Global Search to jump to your profile, and use it when writing to support."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare cont are un ID permanent în forma PRVIO-XXXXXXXX, derivat din contul însuși. Îl găsești în Profil — atinge-l ca să-l copiezi. Îl poți tasta și în căutarea globală ca să sari la profil, și îl poți folosi când scrii la suport."
          }
        }
      }
    },
    "faq_account_id_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is my account ID?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce este ID-ul contului?"
          }
        }
      }
    },
    "faq_add_property_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Settings › My Property and tap +. Fill in the address and type, add a cover photo and extra gallery photos if you like. You can hold several properties on one account and switch between them — every module (tasks, finances, chat, plants) re-scopes to the selected property."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergi la Setări › Proprietatea mea și atinge +. Completează adresa și tipul, adaugă o poză de copertă și fotografii în galerie dacă vrei. Poți avea mai multe proprietăți pe același cont și poți comuta între ele — fiecare modul (sarcini, finanțe, chat, plante) se re-scopează pe proprietatea aleasă."
          }
        }
      }
    },
    "faq_add_property_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I add a property?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum adaug o proprietate?"
          }
        }
      }
    },
    "faq_applock_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes — Settings › Security & Privacy can require Face ID / Touch ID to open the app, and individual sections can be locked separately. Sensitive keys are stored in the device Keychain only."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da — Setări › Securitate și confidențialitate poate cere Face ID / Touch ID la deschiderea aplicației, iar secțiuni individuale pot fi blocate separat. Cheile sensibile stau doar în Keychain-ul dispozitivului."
          }
        }
      }
    },
    "faq_applock_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I lock the app with Face ID?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot bloca aplicația cu Face ID?"
          }
        }
      }
    },
    "faq_aria_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA is the property's AI assistant, powered by Claude. It answers with context from your tasks, finances, documents and plants — ask it anything about your home. It only reads your property's data and only when you talk to it."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA este asistentul AI al proprietății, bazat pe Claude. Răspunde cu context din sarcinile, finanțele, documentele și plantele tale — întreab-o orice despre casă. Citește doar datele proprietății tale și doar când vorbești cu ea."
          }
        }
      }
    },
    "faq_aria_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How does ARIA work?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum funcționează ARIA?"
          }
        }
      }
    },
    "faq_backup_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes — data lives in a managed PostgreSQL database (Supabase) with automatic backups, protected by row-level security so each household only ever sees its own rows. Changing devices loses nothing."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da — datele stau într-o bază PostgreSQL administrată (Supabase) cu backup-uri automate, protejată cu securitate la nivel de rând, astfel încât fiecare gospodărie își vede doar propriile date. Schimbarea telefonului nu pierde nimic."
          }
        }
      }
    },
    "faq_backup_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is my data backed up?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt datele mele salvate?"
          }
        }
      }
    },
    "faq_budgets_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set monthly budgets per category in Finances. Expenses you log (or scan from receipts) count against them, and the dashboard shows how much of each envelope is used. Amounts display in your chosen currency at real rates."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează bugete lunare pe categorii în Finanțe. Cheltuielile înregistrate (sau scanate din bonuri) se scad din ele, iar dashboard-ul arată cât din fiecare plic e folosit. Sumele se afișează în moneda aleasă, la cursuri reale."
          }
        }
      }
    },
    "faq_budgets_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do budgets work?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum funcționează bugetele?"
          }
        }
      }
    },
    "faq_calendar_sync_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes — from the task form you can add the due date to the in-app calendar, Apple Calendar, Google Calendar or Apple Reminders. Each destination is explicit, so nothing is written to your calendars without you choosing it."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da — din formularul sarcinii poți adăuga termenul în calendarul aplicației, Calendar Apple, Google Calendar sau Apple Reminders. Fiecare destinație e explicită, deci nimic nu se scrie în calendarele tale fără să alegi tu."
          }
        }
      }
    },
    "faq_calendar_sync_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tasks sync with Calendar and Reminders?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincronizează sarcinile cu Calendarul și Reminders?"
          }
        }
      }
    },
    "faq_cameras_privacy_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on your device, in the Keychain, marked this-device-only — they are never uploaded. The camera list itself is also device-local by design. HomeKit cameras stream through Apple's own framework."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pe dispozitivul tău, în Keychain, marcate doar-pe-acest-dispozitiv — nu sunt urcate niciodată. Însăși lista camerelor e locală pe dispozitiv, prin design. Camerele HomeKit transmit prin framework-ul Apple."
          }
        }
      }
    },
    "faq_cameras_privacy_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are my camera passwords stored?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unde sunt stocate parolele camerelor?"
          }
        }
      }
    },
    "faq_cat_aria": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA, SIRI & DEVICES"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA, SIRI & DISPOZITIVE"
          }
        }
      }
    },
    "faq_cat_chat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CHAT & FAMILY"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CHAT & FAMILIE"
          }
        }
      }
    },
    "faq_cat_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DATA & SECURITY"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DATE & SECURITATE"
          }
        }
      }
    },
    "faq_cat_finance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FINANCES"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FINANȚE"
          }
        }
      }
    },
    "faq_cat_home": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOME & TASKS"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CASĂ & SARCINI"
          }
        }
      }
    },
    "faq_cat_start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GETTING STARTED"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ÎNCEPUT RAPID"
          }
        }
      }
    },
    "faq_communities_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate chat threads per team — family, renovation workers, tenants. Each group has its own conversation, notifications and mute, and only its creator can rename it, manage members or delete it. Group messages never leak into the main house chat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversații separate pe echipe — familie, muncitori la renovare, chiriași. Fiecare grup are propria conversație, propriile notificări și mute, iar doar creatorul îl poate redenumi, gestiona membri sau șterge. Mesajele de grup nu ajung niciodată în chatul principal al casei."
          }
        }
      }
    },
    "faq_communities_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are Communities (groups)?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sunt Comunitățile (grupurile)?"
          }
        }
      }
    },
    "faq_currency_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your display currency in Settings › Appearance › Currency & rates. Rates come from the National Bank of Romania's official daily fixing, with the ECB as fallback — the page always names the real source and when it was updated, and includes a live converter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege moneda de afișare în Setări › Aspect › Monedă și cursuri. Cursurile vin din fixing-ul zilnic oficial BNR, cu BCE ca rezervă — pagina spune mereu sursa reală și când s-a actualizat, și include un convertor live."
          }
        }
      }
    },
    "faq_currency_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do currencies and exchange rates work?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum funcționează monedele și cursurile valutare?"
          }
        }
      }
    },
    "faq_digital_twin_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A live map of your property: zones drawn as polygons, doors, windows and structures as elements, plus layers for utilities, tasks, health and the photo journal. Pins can hold 3D scans, and the time machine shows how the property changed."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O hartă vie a proprietății: zonele desenate ca poligoane, ușile, ferestrele și structurile ca elemente, plus straturi pentru utilități, sarcini, sănătate și jurnalul foto. Pinurile pot ține scanări 3D, iar mașina timpului arată cum s-a schimbat proprietatea."
          }
        }
      }
    },
    "faq_digital_twin_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is the Digital Twin?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce este Digital Twin?"
          }
        }
      }
    },
    "faq_disappearing_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per conversation you can set a lifetime (e.g. 7 days). New messages are stamped with an expiry and the server deletes them after it passes — true deletion, not just hiding in the app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Per conversație poți seta o durată de viață (de ex. 7 zile). Mesajele noi primesc un termen de expirare, iar serverul le șterge după ce trece — ștergere reală, nu doar ascundere în aplicație."
          }
        }
      }
    },
    "faq_disappearing_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do disappearing messages work?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum funcționează mesajele care dispar?"
          }
        }
      }
    },
    "faq_export_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Profile › Safety and security › Export my data produces a JSON file with your tasks, finances, documents, inventory and more — yours to keep, in an open format."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da. Profil › Siguranță și securitate › Exportă datele mele produce un fișier JSON cu sarcinile, finanțele, documentele, inventarul și restul — al tău, în format deschis."
          }
        }
      }
    },
    "faq_export_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I export my data?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot exporta datele mele?"
          }
        }
      }
    },
    "faq_health_score_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The score (0–100) reflects the real state of the home: overdue tasks, documents close to expiry and maintenance rhythm pull it down; completing and renewing pushes it up. It is computed from your data only — there is nothing to configure."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorul (0–100) reflectă starea reală a casei: sarcinile restante, documentele aproape de expirare și ritmul de întreținere îl trag în jos; finalizarea și reînnoirea îl urcă. Se calculează doar din datele tale — nu are nimic de configurat."
          }
        }
      }
    },
    "faq_health_score_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How does the Health Score work?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum funcționează scorul de sănătate?"
          }
        }
      }
    },
    "faq_invite_family_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Settings › Members lets you add people and send single-use invites by email. Each member gets a role (owner, partner, child, tenant, guest) that controls exactly what they see — roles are enforced, not decorative."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da. În Setări › Membri poți adăuga persoane și trimite invitații de unică folosință pe email. Fiecare membru primește un rol (proprietar, partener, copil, chiriaș, invitat) care controlează exact ce vede — rolurile sunt aplicate real, nu decorative."
          }
        }
      }
    },
    "faq_invite_family_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I invite family members?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot invita membrii familiei?"
          }
        }
      }
    },
    "faq_nfc_tags_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the NFC wallet you write a physical tag linked to a zone, element or appliance. Scanning it with the phone opens that place in the app. Requires an iPhone with NFC reading and the tag to be NDEF-formatted."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În portofelul NFC scrii o etichetă fizică legată de o zonă, un element sau un electrocasnic. Scanarea ei cu telefonul deschide acel loc în aplicație. E nevoie de un iPhone cu citire NFC și de o etichetă în format NDEF."
          }
        }
      }
    },
    "faq_nfc_tags_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do NFC tags work?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum funcționează etichetele NFC?"
          }
        }
      }
    },
    "faq_no_results_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another word, or write to us below."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă alt cuvânt sau scrie-ne mai jos."
          }
        }
      }
    },
    "faq_receipts_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes — photograph a receipt and the scanner reconstructs the items, quantities and discounts, checks them off your shopping list and stocks your pantry. Quantities grow when you scan and shrink when you consume."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da — fotografiază un bon și scanerul reconstruiește produsele, cantitățile și reducerile, le bifează din lista de cumpărături și îți umple cămara. Cantitățile cresc când scanezi și scad când consumi."
          }
        }
      }
    },
    "faq_receipts_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can the app read my shopping receipts?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poate aplicația să-mi citească bonurile?"
          }
        }
      }
    },
    "faq_recurring_tasks_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When creating a task, enable Recurring and pick a frequency (daily, weekly, monthly, yearly). After you complete it, the next occurrence is created automatically. Due dates can also land in Apple Calendar, Google Calendar or Reminders from the task form."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când creezi o sarcină, activează Recurentă și alege frecvența (zilnic, săptămânal, lunar, anual). După ce o finalizezi, următoarea apariție se creează automat. Termenele pot ajunge și în Calendar Apple, Google Calendar sau Reminders direct din formular."
          }
        }
      }
    },
    "faq_recurring_tasks_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I set up recurring tasks?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum configurez sarcini recurente?"
          }
        }
      }
    },
    "faq_roles_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roles gate features fail-closed: owners manage everything, partners almost everything, tenants and guests see only what's meant for them (their chat, their tasks). If a role lacks a permission, the section simply isn't there."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolurile limitează funcțiile fail-closed: proprietarii administrează tot, partenerii aproape tot, chiriașii și invitații văd doar ce le e destinat (chatul lor, sarcinile lor). Dacă un rol nu are o permisiune, secțiunea pur și simplu nu apare."
          }
        }
      }
    },
    "faq_roles_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can each role see?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce poate vedea fiecare rol?"
          }
        }
      }
    },
    "faq_search_prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search help…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută în ajutor…"
          }
        }
      }
    },
    "faq_siri_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings › Siri & Shortcuts for the full list with the exact phrases — opening pages, creating tasks, completing the top task, watering plants, checking off shopping items and asking ARIA. Phrases work in Romanian and English."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Setări › Siri & Comenzi rapide pentru lista completă cu frazele exacte — deschidere de pagini, creare de sarcini, finalizarea sarcinii de top, udarea plantelor, bifarea cumpărăturilor și întrebări pentru ARIA. Frazele merg în română și engleză."
          }
        }
      }
    },
    "faq_siri_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can I say to Siri?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce pot să-i spun lui Siri?"
          }
        }
      }
    },
    "faq_statuses_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24-hour stories for the household: a photo or a text card, with view tracking. They expire on their own and can be deleted anytime by their author."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Povești de 24 de ore pentru casă: o poză sau un card de text, cu urmărirea vizualizărilor. Expiră singure și pot fi șterse oricând de autor."
          }
        }
      }
    },
    "faq_statuses_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are statuses?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sunt statusurile?"
          }
        }
      }
    },
    "faq_support_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We usually reply within 24 hours on business days, at support@prvio.app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De obicei răspundem în 24 de ore în zilele lucrătoare, la support@prvio.app."
          }
        }
      }
    },
    "faq_switch_property_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the property name on the dashboard or Settings › My Property. Switching is a full context switch: lists, chat, plants, finances and widgets all follow the newly selected property."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din numele proprietății de pe dashboard sau din Setări › Proprietatea mea. Comutarea e o schimbare completă de context: listele, chatul, plantele, finanțele și widgeturile urmează toate proprietatea nou selectată."
          }
        }
      }
    },
    "faq_switch_property_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I switch between properties?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum comut între proprietăți?"
          }
        }
      }
    },
    "faq_watch_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today glance with health ring, tasks you can complete from the wrist, plant watering, shopping list, deliveries, a property map and dictation for new tasks — plus watch-face complications, including an interactive one that completes your top task."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezumatul zilei cu inel de sănătate, sarcini pe care le finalizezi de la încheietură, udarea plantelor, lista de cumpărături, livrări, harta proprietății și dictare pentru sarcini noi — plus complicații pe cadran, inclusiv una interactivă care finalizează sarcina de top."
          }
        }
      }
    },
    "faq_watch_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does the Apple Watch app do?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce face aplicația de Apple Watch?"
          }
        }
      }
    },
    "faq_widgets_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Screen widgets in several sizes (tasks, shopping, deliveries, plants, budgets, brand), Lock Screen accessories, Control Center controls and Live Activities on the Lock Screen and in Dynamic Island. Add them from the system widget gallery — search for PRVIO."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgeturi pe ecranul principal în mai multe mărimi (sarcini, cumpărături, livrări, plante, bugete, brand), accesorii pe ecranul blocat, controale în Control Center și Live Activities pe ecranul blocat și în Dynamic Island. Le adaugi din galeria de widgeturi a sistemului — caută PRVIO."
          }
        }
      }
    },
    "faq_widgets_q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What widgets are available?"
          }
        },
