    "ws_p1_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Today dashboard brings the property's health score, open tasks, thirsty plants, deliveries and the shopping list to your Apple Watch — updated automatically from your iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoul Today aduce scorul de sănătate al proprietății, sarcinile deschise, plantele însetate, livrările și lista de cumpărături pe Apple Watch — actualizate automat de pe iPhone."
          }
        }
      }
    },
    "ws_p1_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The house on your wrist"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Casa pe încheietura ta"
          }
        }
      }
    },
    "ws_p2_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six complications — status, tasks, water, shopping, deliveries and health score — in every accessory shape. Compose your watch face; a tap opens the exact page."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șase complicații — status, sarcini, udat, cumpărături, livrări și scorul de sănătate — în toate formele de cadran. Compune-ți cadranul; o atingere deschide exact pagina potrivită."
          }
        }
      }
    },
    "ws_p2_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complications for your face"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Complicații pentru cadranul tău"
          }
        }
      }
    },
    "ws_p3_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete tasks, water plants and check off purchases with a tap — the symbol fills, bounces, and the row leaves after the little celebration. Dictate new tasks straight to the watch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizezi sarcini, uzi plante și bifezi cumpărături cu o atingere — simbolul se umple, saltă, iar rândul pleacă după mica sărbătoare. Dictezi sarcini noi direct pe ceas."
          }
        }
      }
    },
    "ws_p3_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act from the wrist"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acționezi de pe încheietură"
          }
        }
      }
    },
    "ws_p4_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shopping list checks off from the wrist, and every parcel shows its courier, status and ETA — the same live data the iPhone tracks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de cumpărături se bifează de pe încheietură, iar fiecare colet își arată curierul, statusul și ETA — aceleași date live pe care le urmărește iPhone-ul."
          }
        }
      }
    },
    "ws_p4_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shopping & deliveries, live"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpărături și livrări, live"
          }
        }
      }
    },
    "ws_p5_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to sign into and nothing to configure: the iPhone pushes everything automatically, and the watch keeps working from its last sync even when the phone is out of reach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic de configurat, nicio autentificare: iPhone-ul împinge totul automat, iar ceasul funcționează din ultima sincronizare chiar și când telefonul nu e în apropiere."
          }
        }
      }
    },
    "ws_p5_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero setup"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero configurare"
          }
        }
      }
    },
    "ws_row_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The house on your wrist: dashboard, complications and wrist actions."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Casa pe încheietură: panou, complicații și acțiuni de pe ceas."
          }
        }
      }
    },
