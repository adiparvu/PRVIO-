    "watch_data_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every sync carries the live house state: tasks, plants, shopping, pantry, deliveries, weather, budget and the house streak — on your wrist, even offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare sincronizare duce starea vie a casei: sarcini, plante, cumpărături, cămară, livrări, vremea, bugetul și seria casei — pe încheietură, chiar și offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque synchronisation apporte l’état de la maison en direct : tâches, plantes, courses, garde-manger, livraisons, météo, budget et série de la maison — à votre poignet, même hors ligne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke synchronisatie brengt de actuele staat van het huis mee: taken, planten, boodschappen, voorraad, leveringen, weer, budget en de reeks van het huis — om je pols, zelfs offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Synchronisierung bringt den aktuellen Stand des Hauses mit: Aufgaben, Pflanzen, Einkäufe, Vorrat, Lieferungen, Wetter, Budget und die Haus-Serie — an deinem Handgelenk, auch offline."
          }
        }
      }
    },
    "watch_data_header": {
      "localizations": {
