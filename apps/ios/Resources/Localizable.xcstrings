            "state": "translated",
            "value": "Mai puțin"
          }
        }
      }
    },
    "hub_guide_more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn more"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Află mai multe"
          }
        }
      }
    },
    "hub_guide_more_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A HomePod, HomePod mini or Apple TV signed into the same home becomes the hub automatically. Set it up in Apple's Home app; automations, notifications and away-from-home access start working on their own."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un HomePod, un HomePod mini sau un Apple TV conectat la aceeași casă devine hub automat. Configurează-l în aplicația Casă de la Apple; automatizările, notificările și accesul din afara casei pornesc de la sine."
          }
        }
      }
    },
    "hub_guide_title": {
      "localizations": {
