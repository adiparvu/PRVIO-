          "stringUnit": {
            "state": "translated",
            "value": "Coduri de unică folosință care deblochează verificarea în doi pași"
          }
        }
      }
    },
    "See all devices and sessions that have accessed your account. You can check active sessions, remove trusted devices, or use \"Sign out of all devices\" to end all sessions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See all devices and sessions that have accessed your account. You can check active sessions, remove trusted devices, or use \"Sign out of all devices\" to end all sessions."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi toate dispozitivele și sesiunile care au accesat contul tău. Poți verifica sesiunile active, elimina dispozitive sau folosi „Deconectează toate celelalte sesiuni” pentru a le încheia."
          }
        }
      }
    },
    "Active now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active now"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activ acum"
          }
        }
      }
    },
    "No active sessions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active sessions"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sesiune activă"
          }
        }
      }
    },
    "Devices appear here after they sign in to your account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices appear here after they sign in to your account."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivele apar aici după ce se autentifică în contul tău."
          }
        }
      }
    },
    "Remove this device?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this device?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimini acest dispozitiv?"
          }
        }
      }
    },
    "Remove device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove device"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină dispozitivul"
          }
        }
      }
    },
    "This removes the device from the registry. It does not sign the device out — use \"Sign out all other sessions\" for that.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the device from the registry. It does not sign the device out — use \"Sign out all other sessions\" for that."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină dispozitivul din registru. Nu îl deconectează — folosește „Deconectează toate celelalte sesiuni” pentru asta."
          }
        }
      }
    },
    "Removing a device only clears it from this list. \"Sign out all other sessions\" actually invalidates their access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a device only clears it from this list. \"Sign out all other sessions\" actually invalidates their access."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea unui dispozitiv doar îl șterge din această listă. „Deconectează toate celelalte sesiuni” le invalidează efectiv accesul."
          }
        }
      }
    },
    "trusted_persons_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted people are saved to your account. Capability toggles are stored, but no backend flow enforces them yet — enforcement arrives in a future update."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Persoanele de încredere sunt salvate în contul tău. Permisiunile sunt stocate, dar nu sunt încă aplicate de niciun flux — aplicarea lor va sosi într-o actualizare viitoare."
          }
        }
      }
    },
