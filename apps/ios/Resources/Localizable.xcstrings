    "ws_fx_caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rain, snow, lightning, lens droplets and fireflies, drawn live on the sky. They pause automatically in Low Power Mode and with Reduce Motion."
