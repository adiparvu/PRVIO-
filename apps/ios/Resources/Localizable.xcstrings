    },
    "watch_complications_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the watch face to add PRVIO complications: budget, tasks, plants and the house streak also live in the Smart Stack."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă lung pe cadranul ceasului ca să adaugi complicațiile PRVIO: bugetul, sarcinile, plantele și seria casei apar și în Smart Stack."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement le cadran pour ajouter les complications PRVIO : le budget, les tâches, les plantes et la série de la maison sont aussi dans le Smart Stack."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de wijzerplaat ingedrukt om PRVIO-complicaties toe te voegen: budget, taken, planten en de reeks van het huis staan ook in de Smart Stack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Zifferblatt gedrückt, um PRVIO-Komplikationen hinzuzufügen: Budget, Aufgaben, Pflanzen und die Haus-Serie gibt’s auch im Smart Stack."
          }
        }
      }
    },
