    "sec_device_remove_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the device from the registry. It does not sign the device out — use \"Sign out all other sessions\" for that."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină dispozitivul din registru. Nu îl deconectează — folosește „Deconectează toate celelalte sesiuni\" pentru asta."
          }
        }
      }
    },
    "sec_device_remove_note2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a device only clears it from this list. \"Sign out all other sessions\" actually invalidates their access."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea unui dispozitiv doar îl șterge din această listă. „Deconectează toate celelalte sesiuni\" îi invalidează cu adevărat accesul."
          }
        }
      }
    },
