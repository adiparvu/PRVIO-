    "Opens the PRVIO quick action selector for instant access to tasks, plants, and AI assistant.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Opens the PRVIO quick action selector for instant access to tasks, plants, and AI assistant."}}, "ro": {"stringUnit": {"state": "translated", "value": "Deschide selectorul de acțiuni rapide PRVIO pentru acces instant la sarcini, plante și asistentul AI."}}}},
    "Adds an expense to PRVIO Finances. Wire it to the Shortcuts 'Transaction' automation to track card payments automatically.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Adds an expense to PRVIO Finances. Wire it to the Shortcuts 'Transaction' automation to track card payments automatically."}}, "ro": {"stringUnit": {"state": "translated", "value": "Adaugă o cheltuială în Finanțe PRVIO. Leag-o de automatizarea „Tranzacție” din Comenzi rapide ca plățile cu cardul să se înregistreze automat."}}}},
    "Opens the first garage or gate in your PRVIO smart home.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Opens the first garage or gate in your PRVIO smart home."}}, "ro": {"stringUnit": {"state": "translated", "value": "Deschide primul garaj sau prima poartă din casa inteligentă PRVIO."}}}},
    "fin_triage_badge": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose category"}}, "ro": {"stringUnit": {"state": "translated", "value": "Alege categoria"}}}},
    "applepay_integration_title": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apple Pay expenses"}}, "ro": {"stringUnit": {"state": "translated", "value": "Cheltuieli Apple Pay"}}}},
    "applepay_integration_desc": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Every Apple Pay payment lands in Finances automatically, via the Shortcuts Transaction automation."}}, "ro": {"stringUnit": {"state": "translated", "value": "Fiecare plată cu Apple Pay intră automat în Finanțe, prin automatizarea Tranzacție din Comenzi rapide."}}}},
    "applepay_guide_intro": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apple keeps Wallet history private, but iOS can run a PRVIO action on every Apple Pay tap. Set it up once — after that, every payment logs itself, categorized by merchant."}}, "ro": {"stringUnit": {"state": "translated", "value": "Apple ține istoricul Wallet privat, dar iOS poate rula o acțiune PRVIO la fiecare plată cu Apple Pay. Configurezi o singură dată — apoi fiecare plată se înregistrează singură, pe categorii, după comerciant."}}}},
    "applepay_step_1": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open the Shortcuts app and go to the Automation tab."}}, "ro": {"stringUnit": {"state": "translated", "value": "Deschide aplicația Comenzi rapide și intră în fila Automatizare."}}}},
    "applepay_step_2": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Tap + and choose the \"Wallet\" trigger (called \"Transaction\" on older iOS)."}}, "ro": {"stringUnit": {"state": "translated", "value": "Apasă + și alege declanșatorul „Portofel” (numit „Tranzacție” pe iOS mai vechi)."}}}},
    "applepay_step_3": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pick the cards you want tracked and select \"Run Immediately\"."}}, "ro": {"stringUnit": {"state": "translated", "value": "Alege cardurile pe care vrei să le urmărești și selectează „Rulează imediat”."}}}},
    "applepay_step_4": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "As the action, search for PRVIO and choose \"Log expense\"."}}, "ro": {"stringUnit": {"state": "translated", "value": "Ca acțiune, caută PRVIO și alege „Înregistrează cheltuială”."}}}},
    "applepay_step_5": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Map the trigger's Merchant to Merchant and Amount to Amount."}}, "ro": {"stringUnit": {"state": "translated", "value": "Leagă Comerciantul declanșatorului la Comerciant și Suma la Sumă."}}}},
    "applepay_step_6": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Done — from now on, every tap logs itself. The expense appears in Finances the next time you open PRVIO."}}, "ro": {"stringUnit": {"state": "translated", "value": "Gata — de acum, fiecare plată se înregistrează singură. Cheltuiala apare în Finanțe la următoarea deschidere a PRVIO."}}}},
    "applepay_open_shortcuts": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open Shortcuts"}}, "ro": {"stringUnit": {"state": "translated", "value": "Deschide Comenzi rapide"}}}},
    "applepay_privacy_note": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Everything runs on your device: PRVIO only receives what the automation sends it — merchant, amount and card name. No bank access, no third parties."}}, "ro": {"stringUnit": {"state": "translated", "value": "Totul rulează pe telefonul tău: PRVIO primește doar ce îi trimite automatizarea — comerciant, sumă și numele cardului. Fără acces la bancă, fără terți."}}}},
    "intent_expense_invalid": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The expense needs a merchant and a positive amount."}}, "ro": {"stringUnit": {"state": "translated", "value": "Cheltuiala are nevoie de un comerciant și o sumă pozitivă."}}}},
    "intent_expense_logged_fmt": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Expense at %@ saved to PRVIO."}}, "ro": {"stringUnit": {"state": "translated", "value": "Cheltuiala la %@ a fost salvată în PRVIO."}}}},
    "expense_via_card_fmt": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apple Pay · %@"}}, "ro": {"stringUnit": {"state": "translated", "value": "Apple Pay · %@"}}}},
