    "hub_guide_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automations and remote access need a hub — a HomePod or an Apple TV. Without one, control works only on your home network."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatizările și accesul de la distanță cer un hub — HomePod sau Apple TV. Fără el, controlul funcționează doar în rețeaua casei."
          }
        }
      }
    },
    "hub_guide_less": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show less"
          }
        },
        "ro": {
