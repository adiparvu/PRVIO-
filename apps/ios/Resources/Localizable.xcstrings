    "Any app that can send a POST request can deliver messages: Shortcuts automations, Zapier, IFTTT, a home server. Rotating the token instantly disconnects everything using the old one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any app that can send a POST request can deliver messages: Shortcuts automations, Zapier, IFTTT, a home server. Rotating the token instantly disconnects everything using the old one."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice aplicație care poate trimite un POST poate livra mesaje: automatizări Shortcuts, Zapier, IFTTT, un server de acasă. Regenerarea tokenului deconectează instant tot ce folosea tokenul vechi."
          }
        }
      }
    },
