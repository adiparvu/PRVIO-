        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ploaie, ninsoare, fulgere, picături pe lentilă și licurici, desenate live pe cer. Se opresc automat în modul Consum redus și cu Reducere mișcare."
          }
        }
      }
