    "iot_wh_example_caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "POST with Content-Type: application/json to the address above. “event” can be “alert” (sends a push notification) or “clear” (ends the alert); every event lands in the sensor's history."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite POST cu Content-Type: application/json către adresa de mai sus. „event” poate fi „alert” (trimite o notificare push) sau „clear” (închide alerta); fiecare eveniment intră în istoricul senzorului."
          }
        }
      }
    },
