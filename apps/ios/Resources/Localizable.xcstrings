            "state": "translated",
            "value": "Wataj live în Dynamic Island cât timp aplicația citește senzorii"
          }
        }
      }
    },
    "iot_feedback_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A door/window sensor that confirms the real position. Without one, the app only reports that the command ran — never \"open\" or \"closed\"."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un senzor de ușă/fereastră care confirmă poziția reală. Fără el, aplicația raportează doar că a rulat comanda — niciodată „deschis” sau „închis”."
          }
        }
      }
    },
    "iot_feedback_none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
