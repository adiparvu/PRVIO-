          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzor de confirmare"
          }
        }
      }
    },
    "iot_production_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagged sensors count as production in the Energy view instead of consumption."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzorii marcați contează ca producție în vizualizarea Energie, nu drept consum."
          }
        }
      }
    },
    "iot_production_toggle": {
