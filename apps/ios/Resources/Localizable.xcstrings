          }
        }
      }
    },
    "emg_guide_disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A general guide, not a substitute for emergency services. In immediate danger, call 112 first."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghid orientativ, nu înlocuiește serviciile de urgență. Într-un pericol imediat, sună întâi la 112."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un guide général, qui ne remplace pas les services d’urgence. En cas de danger immédiat, appelez d’abord le 112."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een algemene gids, geen vervanging voor de hulpdiensten. Bij direct gevaar bel je eerst 112."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein allgemeiner Leitfaden, kein Ersatz für den Notdienst. Bei akuter Gefahr ruf zuerst die 112 an."
          }
        }
      }
    },
    "emg_guide_fire_step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get everyone out of the house immediately. Don't stop for belongings."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoate imediat pe toată lumea din casă. Nu te opri după lucruri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites sortir tout le monde immédiatement. Ne vous arrêtez pas pour vos affaires."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal iedereen meteen het huis uit. Blijf niet staan voor spullen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring sofort alle aus dem Haus. Halte nicht für Sachen an."
          }
        }
      }
    },
    "emg_guide_fire_step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call 112 as soon as you are safe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună la 112 imediat ce ești în siguranță."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez le 112 dès que vous êtes en sécurité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel 112 zodra je in veiligheid bent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruf die 112 an, sobald du in Sicherheit bist."
          }
        }
      }
    },
    "emg_guide_fire_step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch doors with the back of your hand before opening — if a door is hot, don't open it."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge ușile cu dosul palmei înainte să le deschizi — dacă sunt fierbinți, nu le deschide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les portes du dos de la main avant d’ouvrir — si une porte est chaude, ne l’ouvrez pas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voel met de rug van je hand aan deuren voor je ze opent — is een deur heet, open hem dan niet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühre Türen mit dem Handrücken, bevor du sie öffnest — ist eine Tür heiß, öffne sie nicht."
          }
        }
      }
    },
    "emg_guide_fire_step4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there is smoke, stay low, close to the floor. Don't use the lift."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă e fum, mergi aplecat, aproape de podea. Nu folosi liftul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il y a de la fumée, restez bas, près du sol. N’utilisez pas l’ascenseur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is er rook, blijf dan laag, dicht bij de vloer. Neem niet de lift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Rauch bleib unten, nah am Boden. Nimm nicht den Aufzug."
          }
        }
      }
    },
    "emg_guide_fire_step5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only fight a small fire yourself, and only with a clear exit behind you."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stinge singur doar un foc mic și doar dacă ai o ieșire liberă în spate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’éteignez vous-même qu’un petit feu, et seulement avec une sortie dégagée derrière vous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blus alleen zelf een klein vuur, en alleen met een vrije uitgang achter je."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche nur ein kleines Feuer selbst, und nur mit einem freien Ausgang hinter dir."
          }
        }
      }
    },
    "emg_guide_fire_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Incendiu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incendie"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brand"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brand"
          }
        }
      }
    },
    "emg_guide_flood_step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shut off the main water valve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide robinetul general de apă."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez le robinet d’arrivée d’eau principal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai de hoofdkraan van het water dicht."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh den Hauptwasserhahn zu."
          }
        }
      }
    },
    "emg_guide_flood_step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut the power at the breaker panel if water is getting near outlets or cables."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește curentul de la tabloul electric dacă apa se apropie de prize sau de cabluri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupez le courant au tableau électrique si l’eau approche des prises ou des câbles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de stroom uit in de meterkast als het water bij stopcontacten of kabels komt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Strom am Sicherungskasten ab, wenn Wasser in die Nähe von Steckdosen oder Kabeln kommt."
          }
        }
      }
    },
    "emg_guide_flood_step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move valuables and documents up, away from the water."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută obiectele de valoare și documentele mai sus, departe de apă."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les objets de valeur et les documents en hauteur, loin de l’eau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet waardevolle spullen en documenten hoger, weg van het water."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring Wertsachen und Dokumente nach oben, weg vom Wasser."
          }
        }
      }
    },
    "emg_guide_flood_step4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the damage for insurance before you clean up."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiază pagubele pentru asigurare înainte să faci curățenie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez les dégâts pour l’assurance avant de nettoyer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer de schade voor de verzekering voordat je opruimt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere den Schaden für die Versicherung, bevor du aufräumst."
          }
        }
      }
    },
    "emg_guide_flood_step5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the water comes from neighbours or a shared pipe, notify the building manager and a plumber."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă apa vine de la vecini sau din instalația comună, anunță asociația și un instalator."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’eau vient des voisins ou d’une conduite commune, prévenez le syndic et un plombier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt het water van de buren of een gedeelde leiding, laat het dan de VvE en een loodgieter weten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt das Wasser von den Nachbarn oder einer gemeinsamen Leitung, sag der Hausverwaltung und einem Installateur Bescheid."
          }
        }
      }
    },
    "emg_guide_flood_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flood"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inundație"
          }
        },
        "fr": {
